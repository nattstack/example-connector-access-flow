{
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "bun run check:format && bun run check:lint && bun run check:type",
    "check:fix": "bun run check:format:fix && bun run check:lint:fix && bun run check:type",
    "check:format": "oxfmt --check",
    "check:format:fix": "oxfmt",
    "check:lint": "oxlint",
    "check:lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
    "check:type": "tsc --build",
    "dev": "vite",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nattstack/ui": "0.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.76.0",
    "typescript": "~6.0.2",
    "vite": "8.2.2"
  }
